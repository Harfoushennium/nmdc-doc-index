{
  "schema_version": "3",
  "workbook_sheets": [
    "Home",
    "Master Documents",
    "Revisions",
    "Transactions",
    "Review Flags",
    "User Decisions",
    "Configuration",
    "Rules & Mappings",
    "Update History",
    "Error Log",
    "Help",
    "System Data",
    "File Review",
    "Change Details",
    "Custom Fields"
  ],
  "buttons": {
    "Update Changed Files": {
      "command": "stage",
      "mode": "incremental"
    },
    "Full Rescan / Rebuild All": {
      "command": "stage",
      "mode": "full"
    },
    "Approve Update": {
      "command": "approve",
      "requires_displayed_run_id": true,
      "explicit_conflict_confirmation": true,
      "requires_saved_file_review": true,
      "target_sheet": "File Review"
    },
    "Hold Update": {
      "command": "hold",
      "requires_displayed_run_id": true
    },
    "Reject Update": {
      "command": "reject",
      "requires_displayed_run_id": true
    },
    "Select Data Folder": {
      "command": "local-vba",
      "action": "set-data-folder"
    },
    "Refresh Dashboard": {
      "command": "export-excel"
    },
    "Review Flags": {
      "command": "export-excel",
      "target_sheet": "Review Flags"
    },
    "Flag Wrong Data": {
      "command": "user-flag"
    },
    "Configuration": {
      "command": "local-vba",
      "target_sheet": "Configuration"
    },
    "Rules & Mappings": {
      "command": "local-vba",
      "target_sheet": "Rules & Mappings"
    },
    "Report Requirement / Problem": {
      "command": "support-request"
    },
    "View Log": {
      "command": "export-excel",
      "target_sheet": "Error Log"
    },
    "Help": {
      "command": "local-vba",
      "target_sheet": "Help"
    },
    "Review File Updates": {
      "command": "export-excel",
      "target_sheet": "File Review"
    }
  },
  "secondary_controls": {
    "Save Review Decisions": {
      "command": "save-review-decisions",
      "source_table": "ReviewFlags"
    },
    "Check All Sources": {
      "command": "local-vba",
      "binary_choice": true
    },
    "Uncheck All Sources": {
      "command": "local-vba",
      "binary_choice": true
    },
    "Undo Last Approval": {
      "command": "undo",
      "restores_previous_approved_version": true
    },
    "Reset All Records": {
      "command": "reset",
      "preserves_source_data": true,
      "preserves_configuration": true,
      "preserves_audit_history": true
    },
    "Save File Choices": {
      "command": "save-file-review",
      "source_table": "FileReview",
      "requires_displayed_run_id": true,
      "restage_after_save": false
    },
    "View Change Details": {
      "command": "local-vba",
      "target_sheet": "Change Details",
      "optional": true
    }
  },
  "exchange_files": [
    "dashboard.csv",
    "master_documents.csv",
    "revisions.csv",
    "events.csv",
    "pending_update.csv",
    "flags.csv",
    "history.csv",
    "errors.csv",
    "source_selection.csv",
    "file_review.csv"
  ],
  "exchange_columns": {
    "flags.csv": [
      "Select?",
      "Flag Level",
      "Plain-English Problem",
      "Recommended User Action",
      "User Decision",
      "User Comment",
      "Resolution Status",
      "Source File",
      "Worksheet Name",
      "Project No.",
      "Document No.",
      "Revision",
      "Flag Code",
      "Source Row",
      "Source Cell",
      "Event Key"
    ],
    "errors.csv": [
      "Date/Time",
      "Severity",
      "Action",
      "Plain-English Error",
      "Recommended Action",
      "Technical Detail",
      "Run ID",
      "Source File",
      "Worksheet",
      "Source Row/Cell"
    ],
    "source_selection.csv": [
      "Include in Index?",
      "Source File",
      "Source Family",
      "Current Status",
      "Owner Note",
      "Selection Reason",
      "Last Processed Run"
    ],
    "file_review.csv": [
      "Accept Update?",
      "Project No.",
      "Source File",
      "Change Type",
      "Added",
      "Modified",
      "Removed",
      "Owner Note"
    ]
  },
  "flag_levels": [
    "OK",
    "REVIEW",
    "CONFLICT"
  ],
  "approved_state_rule": "Approved master data changes only after an explicit Approve Update action.",
  "approval_binding_rule": "Approve only the exact pending run ID that was successfully refreshed, displayed, and reviewed in Excel.",
  "stale_review_rule": "If exchange export or refresh fails, do not open or announce an older review table as current.",
  "identifier_preservation_rule": "Import exchange CSV fields as text unless the engine contract explicitly declares a non-identifier typed field.",
  "source_file_hyperlink_rule": "Every table column that identifies a source workbook must be converted to a clickable Excel hyperlink resolved against the selected Data Folder.",
  "user_input_rule": "Use Excel checkboxes for genuine binary owner choices when practical, especially include/exclude source scope. Use dropdown lists for mutually exclusive choices with three or more meanings. Keep explanatory comments/notes as free text. Avoid dense checkbox controls on large extraction tables where they would reduce performance or readability.",
  "source_selection_rule": "Persistent source scope remains configuration-driven and distinct from proposal acceptance.",
  "review_flag_workflow_rule": "Review Flags uses native Select? checkboxes plus explicit Source File and Worksheet Name columns. Parser-fix reports are written to sequential PARSER_FIX_REPORTS/NNNN folders and explicitly saved to the staged-run audit trail.",
  "wrong_data_context": [
    "run_id",
    "source_file",
    "worksheet",
    "source_row",
    "source_cell",
    "project_no",
    "document_no",
    "revision",
    "event_identity",
    "flag_code",
    "current_field",
    "current_value",
    "expected_value",
    "user_note",
    "user_name",
    "parser_version",
    "configuration_version"
  ],
  "technical_conflicts_rule": "Non-overridable technical conflicts must be corrected and restaged before approval.",
  "dynamic_rules_rule": "Business classifications and mappings must be user-editable in Excel and synchronized to engine configuration without source-code edits.",
  "normal_user_interface": "Excel only",
  "file_review_rule": "File Review shows affected files only. Checked accepts the file update; unchecked retains its approved records and manifest/cache baseline for this proposal. Save choices for the exact displayed run before approval. Change Details is optional."
}
