{
  "schema_version": "1",
  "workbook_sheets": [
    "Home",
    "Master Documents",
    "Revisions",
    "Transactions",
    "Pending Update",
    "Review Flags",
    "User Decisions",
    "Configuration",
    "Rules & Mappings",
    "Update History",
    "Error Log",
    "Help",
    "System Data"
  ],
  "buttons": {
    "Update Changed Files": {"command": "stage", "mode": "incremental"},
    "Full Rescan / Rebuild All": {"command": "stage", "mode": "full"},
    "Review Pending Update": {"command": "export-excel", "target_sheet": "Pending Update"},
    "Approve Update": {"command": "approve", "requires_displayed_run_id": true, "explicit_conflict_confirmation": true},
    "Hold Update": {"command": "hold", "requires_displayed_run_id": true},
    "Reject Update": {"command": "reject", "requires_displayed_run_id": true},
    "Select Data Folder": {"command": "local-vba", "action": "set-data-folder"},
    "Refresh Dashboard": {"command": "export-excel"},
    "Review Flags": {"command": "export-excel", "target_sheet": "Review Flags"},
    "Flag Wrong Data": {"command": "user-flag"},
    "Configuration": {"command": "local-vba", "target_sheet": "Configuration"},
    "Rules & Mappings": {"command": "local-vba", "target_sheet": "Rules & Mappings"},
    "Report Requirement / Problem": {"command": "support-request"},
    "View Log": {"command": "export-excel", "target_sheet": "Error Log"},
    "Help": {"command": "local-vba", "target_sheet": "Help"}
  },
  "exchange_files": [
    "dashboard.csv",
    "master_documents.csv",
    "revisions.csv",
    "events.csv",
    "pending_update.csv",
    "flags.csv",
    "history.csv",
    "errors.csv"
  ],
  "exchange_columns": {
    "flags.csv": [
      "Flag Level",
      "Flag Code",
      "Plain-English Problem",
      "Recommended User Action",
      "Project No.",
      "Document No.",
      "Revision",
      "Source File",
      "Source Sheet",
      "Source Row",
      "Source Cell",
      "User Decision",
      "User Comment",
      "Resolution Status",
      "Event Key"
    ],
    "errors.csv": [
      "Date/Time",
      "Severity",
      "Action",
      "Plain-English Error",
      "Recommended Action",
      "Technical Detail",
      "Run ID",
      "Source File",
      "Worksheet",
      "Source Row/Cell"
    ]
  },
  "flag_levels": ["OK", "REVIEW", "CONFLICT"],
  "approved_state_rule": "Approved master data changes only after an explicit Approve Update action.",
  "approval_binding_rule": "Approve only the exact pending run ID that was successfully refreshed, displayed, and reviewed in Excel.",
  "stale_review_rule": "If exchange export or refresh fails, do not open or announce an older review table as current.",
  "identifier_preservation_rule": "Import exchange CSV fields as text unless the engine contract explicitly declares a non-identifier typed field.",
  "wrong_data_context": [
    "run_id",
    "source_file",
    "worksheet",
    "source_row",
    "source_cell",
    "project_no",
    "document_no",
    "revision",
    "event_identity",
    "flag_code",
    "current_field",
    "current_value",
    "expected_value",
    "user_note",
    "user_name",
    "parser_version",
    "configuration_version"
  ],
  "technical_conflicts_rule": "Non-overridable technical conflicts must be corrected and restaged before approval.",
  "dynamic_rules_rule": "Business classifications and mappings must be user-editable in Excel and synchronized to engine configuration without source-code edits.",
  "normal_user_interface": "Excel only"
}
