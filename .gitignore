# Python runtime artifacts
__pycache__/
*.py[cod]

# Local runtime state generated by the future Excel/update engine
/runtime/

# Generated from the audited chunk set during production packaging
/excel/NMDC_Document_Index_Base.xlsx

# Antigravity / local Excel simulation artifacts
/.antigravity/
/antigravity-work/
/tests/excel_e2e/artifacts/
*.log
~$*.xls*

# Generated profiler/extractor evidence; CI regenerates this from DATA/
/outputs/

# PyInstaller build artefacts (regenerable: pyinstaller nmdc_index_engine.spec)
/build/
/dist/
/*.spec

# Local runtime test/scan state (regenerable engine output; not project source)
/runtime_test_compat/
/runtime_test_scan/

# Antigravity IDE session scratch and local context files
/.tmp/
/.antigravity_context.md
/Antigravity_NMDC_START_HERE.md
/build_log.md

# Local backup folders created by Antigravity session management
/_backup_*/

# Antigravity collaboration skill (local only; not NMDC project source)
/.agents/

# Local production-package assembly (regenerable via assemble_package.py)
# Uncomment below to also ignore the assembled package folder
# /production-package/
